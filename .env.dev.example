#!/bin/bash

export PYTHONPATH=$(expand_path ./src)
# Your workspace-specific API host (find it in Model Studio console).
# The legacy public host dashscope.aliyuncs.com is being deprecated.
export API_HOST=https://llm-xxxxxx.cn-beijing.maas.aliyuncs.com
export BEIJING_API_KEY=sk-your-api-key
export LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR
export LOG_OUTPUT=file  # Options: file, console, both
export DEFAULT_MODEL=qwen3.7-plus
export LOCAL_MODEL=qwen3:4b
export LOCAL_WEAK_MODEL=qwen2.5:1.5b
export VIRTUAL_ENV="$(expand_path .venv)"
PATH_add "$VIRTUAL_ENV/bin"
